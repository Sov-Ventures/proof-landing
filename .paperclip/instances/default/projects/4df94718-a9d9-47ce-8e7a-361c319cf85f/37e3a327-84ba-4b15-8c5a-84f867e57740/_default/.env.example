# Polymarket Bot Configuration
# Copy to .env and fill in your values

# Wallet (required for live trading)
PRIVATE_KEY=your_wallet_private_key_here

# Polymarket endpoints
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com
CHAIN_ID=137

# ── Certainty Sniper parameters ─────────────────────────────
MIN_ENTRY_PRICE=0.97       # Minimum price to buy (0.97 = 97¢)
MAX_ENTRY_PRICE=0.995      # Maximum price to buy
SECONDS_BEFORE_CLOSE=30    # Enter within N seconds of candle close
MIN_PRICE_MOVE_PCT=0.3     # Minimum % price move to confirm direction
MAX_ORDER_SIZE_USD=500      # Maximum USD per order
CYCLE_INTERVAL_SEC=5        # Seconds between market scans

# ── Copytrader parameters ───────────────────────────────────
TARGET_WALLET=              # Target wallet address (0x...) or @username
COPY_MODE=fixed             # "fixed" = same USD per trade, "proportional" = % of target size
FIXED_ORDER_SIZE_USD=50     # USD per copied trade (fixed mode)
PROPORTIONAL_FACTOR=0.1    # Fraction of target's trade size (proportional mode)
MAX_SLIPPAGE=0.03           # Max price diff from target's fill (in dollars, e.g. 0.03 = 3¢)
POLL_INTERVAL_SEC=15        # Seconds between checking for new trades
TRADE_STALENESS_SEC=300     # Ignore trades older than this (seconds)
MIN_ORDER_SIZE_USD=5        # Minimum order size

# Safety
DRY_RUN=true               # Set to false for live trading
LOG_LEVEL=INFO

# ── BTC Weekly Pattern (Hyperliquid) ───────────────────────
HL_PRIVATE_KEY=             # Hyperliquid wallet private key
HL_WALLET_ADDRESS=          # Hyperliquid wallet address (0x...)
HL_MAINNET=true             # true=mainnet, false=testnet
DIP_THRESHOLD_PCT=0.25      # Max dip % below Monday open (pattern threshold)
POSITION_SIZE_USD=1000      # USD notional per trade
HL_LEVERAGE=3               # Leverage multiplier
STOP_LOSS_PCT=3.0           # Stop loss % below entry
TAKE_PROFIT_PCT=15.0        # Take profit % above entry
CHECK_INTERVAL_SEC=300      # Seconds between checks (5 min default)
